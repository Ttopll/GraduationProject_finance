<view class="container">
  <view class="card">
    <view class="title">Retail Overview (Top 5)</view>
    <button size="mini" bindtap="loadRetailOverview" loading="{{loading}}">刷新</button>
    <button size="mini" type="warn" bindtap="logout">退出</button>

    <view wx:if="{{summary}}" class="summary">
      <view>总记录数: {{summary.totalRecords}}</view>
      <view>总交易额: {{summary.totalAmount}}</view>
      <view>平均金额: {{summary.averageAmount}}</view>
      <view>最早: {{summary.earliestInvoiceTime}}</view>
      <view>最晚: {{summary.latestInvoiceTime}}</view>
    </view>

    <view class="subtitle">国家交易额 Top 5</view>
    <view wx:for="{{topCountries}}" wx:key="country" class="row">
      <text>{{index + 1}}. {{item.country}}</text>
      <text>{{item.totalAmount}}</text>
    </view>

    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
