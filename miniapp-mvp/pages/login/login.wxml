<view class="login-shell">
  <view class="login-hero">
    <view class="panel-kicker">Finance Mini</view>
    <view class="login-title">Finance User App</view>
    <view class="login-desc">Sign in first, then open home, accounts, records, alerts and profile.</view>
  </view>

  <view class="panel-card">
    <view class="panel-head">
      <view>
        <view class="panel-kicker">Account Login</view>
        <view class="panel-title">Sign In</view>
      </view>
    </view>

    <view class="field-stack">
      <view class="field-block">
        <view class="field-label">Username</view>
        <input class="field-input" placeholder="Enter username" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="field-block">
        <view class="field-label">Password</view>
        <input class="field-input" password placeholder="Enter password" value="{{password}}" bindinput="onPasswordInput" />
      </view>
    </view>

    <view class="button-row" style="margin-top: 20rpx;">
      <button class="primary-btn" loading="{{loading}}" bindtap="submitLogin">Login</button>
      <button class="ghost-btn" bindtap="fillDemo">Use Demo</button>
    </view>

    <view class="feedback-box {{feedback.indexOf('failed') >= 0 ? 'error' : feedback.indexOf('success') >= 0 ? 'success' : ''}}" wx:if="{{feedback}}" style="margin-top: 20rpx;">
      {{feedback}}
    </view>
  </view>
</view>