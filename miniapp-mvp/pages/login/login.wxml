<view class="login-shell">
  <view class="login-hero">
    <view class="panel-kicker">家庭理财</view>
    <view class="login-title">家庭理财小程序</view>
    <view class="login-desc">先登录账号，然后查看家庭账本、账户、流水、提醒和个人信息。</view>
  </view>

  <view class="panel-card">
    <view class="panel-head">
      <view>
        <view class="panel-kicker">账号登录</view>
        <view class="panel-title">登录</view>
      </view>
    </view>

    <view class="field-stack">
      <view class="field-block">
        <view class="field-label">用户名</view>
        <input class="field-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="field-block">
        <view class="field-label">密码</view>
        <input class="field-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
      </view>
    </view>

    <view class="button-row" style="margin-top: 20rpx;">
      <button class="primary-btn" loading="{{loading}}" bindtap="submitLogin">登录</button>
      <button class="ghost-btn" bindtap="fillDemo">填入演示账号</button>
    </view>

    <view class="feedback-box {{feedback.indexOf('失败') >= 0 ? 'error' : feedback.indexOf('成功') >= 0 ? '成功' : ''}}" wx:if="{{feedback}}" style="margin-top: 20rpx;">
      {{feedback}}
    </view>
  </view>
</view>