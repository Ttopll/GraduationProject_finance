<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">Accounts</view>
          <view class="panel-title">Account Overview</view>
          <view class="panel-desc">View current family accounts and balances.</view>
        </view>
        <view class="button-row">
          <button class="primary-btn" bindtap="goCreate">New</button>
          <button class="ghost-btn" bindtap="loadAccounts">Refresh</button>
        </view>
      </view>
      <view class="feedback-box" wx:if="{{feedback}}">{{feedback}}</view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-label">Total</view>
        <view class="stat-value">{{stats.total}}</view>
        <view class="stat-meta">Family accounts</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Active</view>
        <view class="stat-value">{{stats.active}}</view>
        <view class="stat-meta">Enabled accounts</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Disabled</view>
        <view class="stat-value">{{stats.disabled}}</view>
        <view class="stat-meta">Stopped accounts</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Balance</view>
        <view class="stat-value">{{stats.totalBalance}}</view>
        <view class="stat-meta">Total account balance</view>
      </view>
    </view>

    <view class="record-list" wx:if="{{accounts.length}}">
      <view class="record-item" wx:for="{{accounts}}" wx:key="id">
        <view class="record-top">
          <view class="record-title">{{item.accountName}}</view>
          <view class="tag">{{item.accountTypeLabel}}</view>
        </view>
        <view class="record-meta">{{item.institutionName || 'No bank'}} / {{item.accountNoMask || 'No tail no.'}}</view>
        <view class="record-bottom" style="margin-top: 12rpx;">
          <view class="record-meta">Status: {{item.status === 1 ? 'Active' : 'Disabled'}}</view>
          <view class="button-row">
            <view class="record-amount amount-transfer">{{item.currentBalanceText}}</view>
            <button class="ghost-btn" size="mini" data-id="{{item.id}}" bindtap="openAccount">Open</button>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-box" wx:else>No account data.</view>
  </view>
</view>
