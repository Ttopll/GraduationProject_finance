<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">Home</view>
          <view class="panel-title">Family Home</view>
          <view class="panel-desc">View current user, family scope, assets and summary.</view>
        </view>
        <button class="ghost-btn" bindtap="logout">Logout</button>
      </view>
      <view class="field-block">
        <view class="field-label">Current Family</view>
        <picker mode="selector" range="{{familyOptions}}" value="{{familyIndex}}" bindchange="onFamilyChange">
          <view class="field-picker {{selectedFamilyId ? '' : 'is-placeholder'}}">{{selectedFamilyId ? currentFamilyLabel : 'No family context'}}</view>
        </picker>
      </view>
      <view class="feedback-box" wx:if="{{feedback}}" style="margin-top: 16rpx;">{{feedback}}</view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-label">Accounts</view>
        <view class="stat-value">{{summary.accountCount}}</view>
        <view class="stat-meta">Visible family accounts</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Balance</view>
        <view class="stat-value">{{summary.totalBalance}}</view>
        <view class="stat-meta">Current total balance</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Net Assets</view>
        <view class="stat-value">{{summary.netAssetValue}}</view>
        <view class="stat-meta">Assets minus liabilities</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Unread</view>
        <view class="stat-value">{{summary.unreadCount}}</view>
        <view class="stat-meta">Alerts and reminders</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Risk Budgets</view>
        <view class="stat-value">{{summary.riskBudgetCount}}</view>
        <view class="stat-meta">Warning or exceeded budgets</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">Rule Alerts</view>
        <view class="stat-value">{{summary.ruleAlertCount}}</view>
        <view class="stat-meta">Notifications generated by rules</view>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">Quick Actions</view>
          <view class="panel-title">Common Actions</view>
        </view>
      </view>
      <view class="button-row">
        <button class="primary-btn" bindtap="goAddTransaction">Add Record</button>
        <button class="ghost-btn" bindtap="goTransactions">View Records</button>
        <button class="ghost-btn" bindtap="goAccounts">View Accounts</button>
        <button class="ghost-btn" bindtap="goNotifications">View Alerts</button>
        <button class="ghost-btn" bindtap="goBudgetSummary">Budget Summary</button>
        <button class="ghost-btn" bindtap="goFamilyInfo">Family Info</button>
        <button class="ghost-btn" bindtap="goProfile">Open Profile</button>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">Risk</view>
          <view class="panel-title">Budget Risk Snapshot</view>
          <view class="panel-desc">Quickly review whether current family budgets are close to warning or already exceeded.</view>
        </view>
        <button class="ghost-btn" bindtap="goBudgetSummary">Open Budgets</button>
      </view>
      <view class="record-list" wx:if="{{riskBudgets.length}}">
        <view class="record-item" wx:for="{{riskBudgets}}" wx:key="budgetId">
        <view class="record-top">
          <view class="record-title">{{item.budgetName}}</view>
          <view class="tag">{{item.exceeded ? 'Exceeded' : 'Warning'}}</view>
        </view>
        <view class="record-meta">{{item.categoryName || '-'}} / {{item.month || '-'}}</view>
        <view class="record-meta">Spent {{item.spentAmountText}} / Budget {{item.budgetAmountText}}</view>
      </view>
      </view>
      <view class="empty-box" wx:else>No risky budget right now.</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">Monthly Summary</view>
          <view class="panel-title">Last 6 Months</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{monthlySummary.length}}">
        <view class="record-item" wx:for="{{monthlySummary}}" wx:key="month">
          <view class="record-top">
            <view class="record-title">{{item.month}}</view>
            <view class="tag">Net {{item.netAmount}}</view>
          </view>
          <view class="record-meta">Income {{item.income}} / Expense {{item.expense}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>No monthly summary data.</view>
    </view>
  </view>
</view>
