<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">家庭首页</view>
          <view class="panel-title">家庭财务总览</view>
          <view class="panel-desc">查看当前家庭的账户、收支、预算预警、财务评分和月报结论。</view>
        </view>
        <button class="ghost-btn" bindtap="logout">退出</button>
      </view>
      <view class="field-block">
        <view class="field-label">当前家庭</view>
        <picker mode="selector" range="{{familyOptions}}" value="{{familyIndex}}" bindchange="onFamilyChange">
          <view class="field-picker {{selectedFamilyId ? '' : 'is-placeholder'}}">{{selectedFamilyId ? currentFamilyLabel : '暂无家庭上下文'}}</view>
        </picker>
      </view>
      <view class="feedback-box" wx:if="{{feedback}}" style="margin-top: 16rpx;">{{feedback}}</view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-label">账户数</view>
        <view class="stat-value">{{summary.accountCount}}</view>
        <view class="stat-meta">当前家庭可见账户</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">账户余额</view>
        <view class="stat-value">{{summary.totalBalance}}</view>
        <view class="stat-meta">账户余额合计</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">净资产</view>
        <view class="stat-value">{{summary.netAssetValue}}</view>
        <view class="stat-meta">资产减去负债</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">健康评分</view>
        <view class="stat-value">{{healthScore.score}}</view>
        <view class="stat-meta">{{healthScore.levelLabel}}</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">预算风险</view>
        <view class="stat-value">{{summary.riskBudgetCount}}</view>
        <view class="stat-meta">预警或超支预算</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">未读提醒</view>
        <view class="stat-value">{{summary.unreadCount}}</view>
        <view class="stat-meta">消息和提醒</view>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">财务月报</view>
          <view class="panel-title">{{monthlyReport ? monthlyReport.title : '月度综合分析'}}</view>
          <view class="panel-desc">由后端综合收支、预算、消费结构、资产负债和理财建议生成。</view>
        </view>
      </view>
      <view wx:if="{{monthlyReport}}" class="summary-list">
        <view class="summary-item">
          <view class="record-title">综合结论</view>
          <view class="record-meta">{{monthlyReport.overallConclusion}}</view>
        </view>
        <view class="summary-item">
          <view class="record-title">收支与预算</view>
          <view class="record-meta">{{monthlyReport.cashFlowConclusion}}</view>
          <view class="record-meta">{{monthlyReport.budgetConclusion}}</view>
        </view>
        <view class="summary-item">
          <view class="record-title">消费与资产</view>
          <view class="record-meta">{{monthlyReport.expenseConclusion}}</view>
          <view class="record-meta">{{monthlyReport.assetDebtConclusion}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>暂无月报数据，请先录入收支、预算或资产负债数据。</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">健康指标</view>
          <view class="panel-title">关键财务指标</view>
        </view>
      </view>
      <view class="stats-grid">
        <view class="stat-card">
          <view class="stat-label">结余率</view>
          <view class="stat-value">{{healthScore.savingsRateText}}</view>
          <view class="stat-meta">收入扣除支出后的比例</view>
        </view>
        <view class="stat-card">
          <view class="stat-label">负债率</view>
          <view class="stat-value">{{healthScore.debtRatioText}}</view>
          <view class="stat-meta">负债占总资产比例</view>
        </view>
        <view class="stat-card">
          <view class="stat-label">流动资金</view>
          <view class="stat-value">{{healthScore.liquidityText}}</view>
          <view class="stat-meta">可覆盖月支出</view>
        </view>
        <view class="stat-card">
          <view class="stat-label">交易数</view>
          <view class="stat-value">{{summary.transactionCount}}</view>
          <view class="stat-meta">家庭流水记录</view>
        </view>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">下一步动作</view>
          <view class="panel-title">系统建议优先处理</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{actionItems.length}}">
        <view class="record-item" wx:for="{{actionItems}}" wx:key="*this">
          <view class="record-title">建议</view>
          <view class="record-meta">{{item}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>暂无行动建议。</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">快捷操作</view>
          <view class="panel-title">常用功能</view>
        </view>
      </view>
      <view class="button-row">
        <button class="primary-btn" bindtap="goAddTransaction">新增流水</button>
        <button class="ghost-btn" bindtap="goTransactions">查看流水</button>
        <button class="ghost-btn" bindtap="goAccounts">账户总览</button>
        <button class="ghost-btn" bindtap="goNotifications">消息提醒</button>
        <button class="ghost-btn" bindtap="goBudgetSummary">预算汇总</button>
        <button class="ghost-btn" bindtap="goFamilyInfo">家庭信息</button>
        <button class="ghost-btn" bindtap="goProfile">个人信息</button>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">预算风险</view>
          <view class="panel-title">预算预警快照</view>
          <view class="panel-desc">快速查看当前家庭是否存在接近上限或已经超支的预算。</view>
        </view>
        <button class="ghost-btn" bindtap="goBudgetSummary">打开预算</button>
      </view>
      <view class="record-list" wx:if="{{riskBudgets.length}}">
        <view class="record-item" wx:for="{{riskBudgets}}" wx:key="budgetId">
          <view class="record-top">
            <view class="record-title">{{item.budgetName}}</view>
            <view class="tag">{{item.exceeded ? '已超支' : '预警'}}</view>
          </view>
          <view class="record-meta">{{item.categoryName || '-'}} / {{item.month || '-'}}</view>
          <view class="record-meta">已用 {{item.spentAmountText}} / 预算 {{item.budgetAmountText}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>当前暂无预算风险。</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">理财建议</view>
          <view class="panel-title">最近建议摘要</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{adviceItems.length}}">
        <view class="record-item" wx:for="{{adviceItems}}" wx:key="id">
          <view class="record-top">
            <view class="record-title">{{item.title}}</view>
            <view class="tag">{{item.levelText}}</view>
          </view>
          <view class="record-meta">{{item.content}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>暂无理财建议，可在管理员端生成建议后查看。</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">月度趋势</view>
          <view class="panel-title">近 6 个月收支</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{monthlySummary.length}}">
        <view class="record-item" wx:for="{{monthlySummary}}" wx:key="month">
          <view class="record-top">
            <view class="record-title">{{item.month}}</view>
            <view class="tag">结余 {{item.netAmount}}</view>
          </view>
          <view class="record-meta">收入 {{item.income}} / 支出 {{item.expense}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>暂无月度汇总数据。</view>
    </view>
  </view>
</view>
