<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">预算</view>
          <view class="panel-title">预算汇总</view>
          <view class="panel-desc">查看预算使用情况和最近几个月的收支。</view>
        </view>
        <view class="button-row">
          <button class="primary-btn" bindtap="goCreate">新增</button>
          <button class="ghost-btn" bindtap="loadBudgetSummary">刷新</button>
        </view>
      </view>
      <view class="feedback-box" wx:if="{{feedback}}">{{feedback}}</view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-label">预算总数</view>
        <view class="stat-value">{{stats.total}}</view>
        <view class="stat-meta">当前启用的预算</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">接近上限</view>
        <view class="stat-value">{{stats.warningCount}}</view>
        <view class="stat-meta">快要达到提醒线</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">已超支</view>
        <view class="stat-value">{{stats.exceededCount}}</view>
        <view class="stat-meta">已经超出预算</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">正常</view>
        <view class="stat-value">{{stats.normalCount}}</view>
        <view class="stat-meta">还在安全范围内</view>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">提醒联动</view>
          <view class="panel-title">预算风险和提醒</view>
          <view class="panel-desc">查看哪些预算需要注意，以及系统是否已经发出提醒。</view>
        </view>
      </view>
      <view class="stats-grid">
        <view class="stat-card">
          <view class="stat-label">风险预算</view>
          <view class="stat-value">{{riskyBudgets.length}}</view>
          <view class="stat-meta">接近上限或已超支的预算</view>
        </view>
        <view class="stat-card">
          <view class="stat-label">预算提醒</view>
          <view class="stat-value">{{notificationStats.budgetCount}}</view>
          <view class="stat-meta">{{notificationStats.budgetUnread}} 条未读预算提醒</view>
        </view>
        <view class="stat-card">
          <view class="stat-label">自动提醒</view>
          <view class="stat-value">{{notificationStats.ruleCount}}</view>
          <view class="stat-meta">{{notificationStats.ruleUnread}} 条未读自动提醒</view>
        </view>
        <view class="stat-card">
          <view class="stat-label">待关注项</view>
          <view class="stat-value">{{coverageRows.length}}</view>
          <view class="stat-meta">需要查看的预算风险</view>
        </view>
      </view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">预算使用</view>
          <view class="panel-title">预算使用情况</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{budgetUsage.length}}">
        <view class="record-item" wx:for="{{budgetUsage}}" wx:key="budgetId">
          <view class="record-top">
            <view class="record-title">{{item.budgetName}}</view>
            <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="record-meta">分类: {{item.categoryName || '-'}} / 月份： {{item.month || '-'}}</view>
          <view class="record-meta">已用 {{item.spentAmountText}} / 预算 {{item.budgetAmountText}} / 剩余 {{item.remainingAmountText}}</view>
          <view class="progress-track" style="margin-top: 14rpx;">
            <view class="progress-fill {{item.progressClass}}" style="width: {{item.progressWidth}};"></view>
          </view>
          <view class="record-bottom" style="margin-top: 12rpx;">
            <view class="record-meta">使用比例</view>
            <view class="button-row">
              <view class="record-amount">{{item.usageRatioText}}</view>
              <button class="ghost-btn" size="mini" data-id="{{item.budgetId}}" bindtap="openBudget">查看</button>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-box" wx:else>暂无预算使用数据，请先创建预算。</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">提醒覆盖</view>
          <view class="panel-title">风险预算 提醒覆盖</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{coverageRows.length}}">
        <view class="record-item" wx:for="{{coverageRows}}" wx:key="budgetId">
          <view class="record-top">
            <view class="record-title">{{item.budgetName}}</view>
            <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="record-meta">{{item.categoryName}} / {{item.month}}</view>
          <view class="record-meta">已用 {{item.spentAmountText}} / 预算 {{item.budgetAmountText}} / 使用比例 {{item.usageRatioText}}</view>
          <view class="record-bottom" style="margin-top: 12rpx;">
            <view class="record-meta">{{item.coverageText}}</view>
            <view class="tag {{item.coverageCount > 0 ? 'status-normal' : 'status-danger'}}">
              {{item.coverageCount > 0 ? '已提醒' : '未提醒'}}
            </view>
          </view>
        </view>
      </view>
      <view class="empty-box" wx:else>当前没有需要重点关注的预算风险。</view>
    </view>

    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">每月</view>
          <view class="panel-title">近 6 个月</view>
        </view>
      </view>
      <view class="record-list" wx:if="{{monthlySummary.length}}">
        <view class="record-item" wx:for="{{monthlySummary}}" wx:key="month">
          <view class="record-top">
            <view class="record-title">{{item.month}}</view>
            <view class="record-amount {{item.netClass}}">{{item.netAmountText}}</view>
          </view>
          <view class="record-meta">收入 {{item.incomeText}} / 支出 {{item.expenseText}}</view>
        </view>
      </view>
      <view class="empty-box" wx:else>暂无月度汇总数据。</view>
    </view>
  </view>
</view>
