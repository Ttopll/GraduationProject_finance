.row-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.row-inline input {
  min-width: 200rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 10rpx;
  padding: 14rpx;
}
.summary-block {
  margin-top: 12rpx;
  border-top: 1rpx solid #e2e8f0;
  padding-top: 10rpx;
}
.subtitle {
  margin-top: 14rpx;
  font-weight: 600;
}
.conclusion-item {
  margin-top: 8rpx;
  border-left: 6rpx solid #2563eb;
  padding-left: 10rpx;
}
