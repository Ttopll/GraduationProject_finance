<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">记录</view>
          <view class="panel-title">{{isEditMode ? '编辑流水' : '新增流水'}}</view>
          <view class="panel-desc">{{isEditMode ? '查看并修改这笔收支记录。' : '填写账户、类型、金额、时间和备注。'}}</view>
        </view>
      </view>

      <view class="field-stack">
        <view class="field-block">
          <view class="field-label">账户</view>
          <picker mode="selector" range="{{accounts}}" range-key="accountName" bindchange="onPickerChange" data-field="accountId">
            <view class="field-picker {{form.accountId ? '' : 'is-placeholder'}}">{{form.accountId ? selectedAccountName : '请选择账户'}}</view>
          </picker>
        </view>

        <view class="field-block">
          <view class="field-label">分类</view>
          <picker wx:if="{{categories.length}}" mode="selector" range="{{categories}}" range-key="categoryName" bindchange="onPickerChange" data-field="categoryId">
            <view class="field-picker {{form.categoryId ? '' : 'is-placeholder'}}">{{form.categoryId ? selectedCategoryName : '可不填'}}</view>
          </picker>
          <view wx:else class="field-picker is-placeholder">可不填</view>
          <view wx:if="{{categoryHint}}" class="feedback-box" style="margin-top: 12rpx;">{{categoryHint}}</view>
          <view wx:if="{{budgetHint}}" class="feedback-box" style="margin-top: 12rpx;">{{budgetHint}}</view>
        </view>

        <view class="field-block">
          <view class="field-label">收支类型</view>
          <picker mode="selector" range="{{['支出','收入','转账']}}" bindchange="onTypeChange">
            <view class="field-picker">{{form.transactionType === 'EXPENSE' ? '支出' : form.transactionType === 'INCOME' ? '收入' : '转账'}}</view>
          </picker>
        </view>

        <view class="field-block">
          <view class="field-label">金额</view>
          <input class="field-input" type="digit" placeholder="请输入金额" value="{{form.amount}}" data-field="amount" bindinput="onFieldInput" />
        </view>

        <view class="field-grid-2">
          <view class="field-block">
            <view class="field-label">日期</view>
            <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
              <view class="field-picker">{{form.date}}</view>
            </picker>
          </view>
          <view class="field-block">
            <view class="field-label">时间</view>
            <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
              <view class="field-picker">{{form.time}}</view>
            </picker>
          </view>
        </view>

        <view class="field-block">
          <view class="field-label">商户/对象</view>
          <input class="field-input" placeholder="例如：超市、工资、转账" value="{{form.merchantName}}" data-field="merchantName" bindinput="onFieldInput" />
        </view>

        <view class="field-block">
          <view class="field-label">备注</view>
          <input class="field-input" placeholder="可不填" value="{{form.note}}" data-field="note" bindinput="onFieldInput" />
        </view>
      </view>

      <view class="button-row" style="margin-top: 20rpx;">
        <button class="primary-btn" loading="{{submitting}}" bindtap="submitForm">{{isEditMode ? '保存修改' : '保存'}}</button>
        <button wx:if="{{isEditMode}}" class="warn-btn" bindtap="deleteRecord">删除</button>
      </view>

      <view class="feedback-box" wx:if="{{feedback}}" style="margin-top: 20rpx;">{{feedback}}</view>
    </view>
  </view>
</view>
