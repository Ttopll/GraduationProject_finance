<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">预算</view>
          <view class="panel-title">{{isEditMode ? '编辑预算' : '新增预算'}}</view>
          <view class="panel-desc">{{isEditMode ? '修改预算金额、周期和提醒比例。' : '为某个分类设置每月或每年的预算。'}}</view>
        </view>
      </view>

      <view class="field-stack">
        <view class="field-block">
          <view class="field-label">分类</view>
          <picker wx:if="{{categories.length}}" mode="selector" range="{{categories}}" range-key="categoryName" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="field-picker">{{categories[categoryIndex].categoryName}}</view>
          </picker>
          <view wx:else class="field-picker is-placeholder">暂无支出分类</view>
        </view>

        <view class="field-block">
          <view class="field-label">预算名称</view>
          <input class="field-input" value="{{form.budgetName}}" data-field="budgetName" bindinput="onFieldInput" />
        </view>

        <view class="field-grid-2">
          <view class="field-block">
            <view class="field-label">周期</view>
            <picker mode="selector" range="{{['每月','每年']}}" value="{{periodIndex}}" bindchange="onPeriodChange">
              <view class="field-picker">{{form.periodType === 'YEAR' ? '每年' : '每月'}}</view>
            </picker>
          </view>
          <view class="field-block">
            <view class="field-label">金额</view>
            <input class="field-input" type="digit" value="{{form.amount}}" data-field="amount" bindinput="onFieldInput" />
          </view>
        </view>

        <view class="field-grid-2">
          <view class="field-block">
            <view class="field-label">提醒比例</view>
            <input class="field-input" type="digit" value="{{form.alertRatio}}" data-field="alertRatio" bindinput="onFieldInput" />
          </view>
          <view class="field-block">
            <view class="field-label">开始日期</view>
            <picker mode="date" value="{{form.startDate}}" bindchange="onStartDateChange">
              <view class="field-picker">{{form.startDate}}</view>
            </picker>
          </view>
        </view>

        <view class="field-block">
          <view class="field-label">结束日期</view>
          <picker mode="date" value="{{form.endDate}}" bindchange="onEndDateChange">
            <view class="field-picker {{form.endDate ? '' : 'is-placeholder'}}">{{form.endDate || '长期有效'}}</view>
          </picker>
        </view>

        <view class="field-block">
          <view class="field-label">备注</view>
          <input class="field-input" value="{{form.remark}}" data-field="remark" bindinput="onFieldInput" />
        </view>
      </view>

      <view wx:if="{{usageHint}}" class="feedback-box" style="margin-top: 20rpx;">{{usageHint}}</view>

      <view class="button-row" style="margin-top: 20rpx;">
        <button class="primary-btn" loading="{{submitting}}" bindtap="submitForm">{{isEditMode ? '保存修改' : '保存'}}</button>
        <button wx:if="{{isEditMode}}" class="ghost-btn" bindtap="toggleEnabled">{{enabled === 1 ? '停用' : '启用'}}</button>
        <button wx:if="{{isEditMode}}" class="warn-btn" bindtap="deleteBudget">删除</button>
      </view>

      <view class="feedback-box" wx:if="{{feedback}}" style="margin-top: 20rpx;">{{feedback}}</view>
    </view>
  </view>
</view>
