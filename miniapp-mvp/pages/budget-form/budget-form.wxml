<view class="page-shell">
  <view class="page-stack">
    <view class="panel-card">
      <view class="panel-head">
        <view>
          <view class="panel-kicker">Budget</view>
          <view class="panel-title">{{isEditMode ? 'Edit Budget' : 'New Budget'}}</view>
          <view class="panel-desc">{{isEditMode ? 'Update budget amount, period and alert ratio.' : 'Create a category budget for monthly or yearly tracking.'}}</view>
        </view>
      </view>

      <view class="field-stack">
        <view class="field-block">
          <view class="field-label">Category</view>
          <picker wx:if="{{categories.length}}" mode="selector" range="{{categories}}" range-key="categoryName" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="field-picker">{{categories[categoryIndex].categoryName}}</view>
          </picker>
          <view wx:else class="field-picker is-placeholder">No expense category</view>
        </view>

        <view class="field-block">
          <view class="field-label">Budget Name</view>
          <input class="field-input" value="{{form.budgetName}}" data-field="budgetName" bindinput="onFieldInput" />
        </view>

        <view class="field-grid-2">
          <view class="field-block">
            <view class="field-label">Period</view>
            <picker mode="selector" range="{{['Monthly','Yearly']}}" value="{{periodIndex}}" bindchange="onPeriodChange">
              <view class="field-picker">{{form.periodType === 'YEAR' ? 'Yearly' : 'Monthly'}}</view>
            </picker>
          </view>
          <view class="field-block">
            <view class="field-label">Amount</view>
            <input class="field-input" type="digit" value="{{form.amount}}" data-field="amount" bindinput="onFieldInput" />
          </view>
        </view>

        <view class="field-grid-2">
          <view class="field-block">
            <view class="field-label">Alert Ratio</view>
            <input class="field-input" type="digit" value="{{form.alertRatio}}" data-field="alertRatio" bindinput="onFieldInput" />
          </view>
          <view class="field-block">
            <view class="field-label">Start Date</view>
            <picker mode="date" value="{{form.startDate}}" bindchange="onStartDateChange">
              <view class="field-picker">{{form.startDate}}</view>
            </picker>
          </view>
        </view>

        <view class="field-block">
          <view class="field-label">End Date</view>
          <picker mode="date" value="{{form.endDate}}" bindchange="onEndDateChange">
            <view class="field-picker {{form.endDate ? '' : 'is-placeholder'}}">{{form.endDate || 'Long term'}}</view>
          </picker>
        </view>

        <view class="field-block">
          <view class="field-label">Remark</view>
          <input class="field-input" value="{{form.remark}}" data-field="remark" bindinput="onFieldInput" />
        </view>
      </view>

      <view wx:if="{{usageHint}}" class="feedback-box" style="margin-top: 20rpx;">{{usageHint}}</view>

      <view class="button-row" style="margin-top: 20rpx;">
        <button class="primary-btn" loading="{{submitting}}" bindtap="submitForm">{{isEditMode ? 'Update' : 'Submit'}}</button>
        <button wx:if="{{isEditMode}}" class="ghost-btn" bindtap="toggleEnabled">{{enabled === 1 ? 'Disable' : 'Enable'}}</button>
        <button wx:if="{{isEditMode}}" class="warn-btn" bindtap="deleteBudget">Delete</button>
      </view>

      <view class="feedback-box" wx:if="{{feedback}}" style="margin-top: 20rpx;">{{feedback}}</view>
    </view>
  </view>
</view>
