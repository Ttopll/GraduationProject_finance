<view class="container">
  <view class="card">
    <view class="title">FRED Series</view>
    <view class="row-inline">
      <input placeholder="序列ID，如 PCE" value="{{seriesId}}" bindinput="onSeriesInput" />
      <button size="mini" type="primary" loading="{{loading}}" bindtap="loadSeries">查询</button>
    </view>

    <view>数据点数量: {{pointCount}}</view>

    <view wx:if="{{firstPoint}}" class="summary-block">
      <view>首点日期: {{firstPoint.date}}</view>
      <view>首点值: {{firstPoint.value}}</view>
    </view>

    <view wx:if="{{lastPoint}}" class="summary-block">
      <view>末点日期: {{lastPoint.date}}</view>
      <view>末点值: {{lastPoint.value}}</view>
    </view>

    <view wx:if="{{!firstPoint && !error}}" class="summary-block">
      <view>当前序列暂无数据点（通常是抓取软降级）。</view>
    </view>

    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
