page {
  background: #f3f6fb;
  color: #1f2937;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.page-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel-card {
  background: #ffffff;
  border: 1rpx solid #dce6f1;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 18rpx 36rpx -24rpx rgba(44, 95, 147, 0.25);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.panel-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: #2c5f93;
  letter-spacing: 2rpx;
}

.panel-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.panel-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-card {
  background: #ffffff;
  border: 1rpx solid #dce6f1;
  border-radius: 20rpx;
  padding: 22rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
}

.stat-value {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
}

.stat-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.primary-btn,
.ghost-btn,
.warn-btn {
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-btn {
  background: #2c5f93;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #dce6f1;
}

.warn-btn {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
}

.field-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 24rpx;
  color: #6b7280;
}

.field-input,
.field-picker {
  width: 100%;
  min-height: 76rpx;
  border: 1rpx solid #dce6f1;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  font-size: 28rpx;
  color: #1f2937;
  display: flex;
  align-items: center;
}

.field-picker.is-placeholder {
  color: #9ca3af;
}

.field-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.feedback-box {
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  background: #f8fbff;
  border: 1rpx solid #dce6f1;
  color: #475569;
}

.feedback-box.error {
  background: #fff1f2;
  border-color: #fecdd3;
  color: #be123c;
}

.feedback-box.success {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #15803d;
}

.summary-list,
.link-list,
.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.summary-item,
.record-item,
.link-item {
  border: 1rpx solid #e5edf5;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  background: #ffffff;
}

.record-top,
.record-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.amount-expense {
  color: #c2410c;
}

.amount-income {
  color: #15803d;
}

.amount-transfer {
  color: #2c5f93;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eef4fa;
  color: #2c5f93;
  font-size: 22rpx;
}

.empty-box {
  padding: 32rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  border: 1rpx dashed #dce6f1;
  border-radius: 18rpx;
  background: #ffffff;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.login-shell {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  background: linear-gradient(180deg, #f6fbff 0%, #edf3f9 100%);
  box-sizing: border-box;
}

.login-hero {
  margin-bottom: 24rpx;
}

.login-title {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #1f2937;
}

.login-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #64748b;
}

.quick-link {
  color: #2c5f93;
  font-size: 24rpx;
}
.progress-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: #e8eef5;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-normal {
  background: linear-gradient(90deg, #6aa6de 0%, #2c5f93 100%);
}

.progress-warn {
  background: linear-gradient(90deg, #fbbf24 0%, #f59e0b 100%);
}

.progress-danger {
  background: linear-gradient(90deg, #fb7185 0%, #e11d48 100%);
}

.status-normal {
  background: #eef4fa;
  color: #2c5f93;
}

.status-warn {
  background: #fff7ed;
  color: #c2410c;
}

.status-danger {
  background: #fff1f2;
  color: #be123c;
}
