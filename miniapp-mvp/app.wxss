page {
  background: #f8fafc;
  color: #0f172a;
  font-family: sans-serif;
}
.container {
  padding: 24rpx;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}
.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.error {
  color: #dc2626;
  margin-top: 12rpx;
  font-size: 26rpx;
}
